# Salin file ini jadi ".env" (atau ".env.local") di folder yang sama,
# lalu isi dengan URL & anon key dari project Supabase kamu sendiri.
# Dashboard Supabase -> Project Settings -> API.
#
# JANGAN commit file ".env" yang udah keisi ke git.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
